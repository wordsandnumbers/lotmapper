# Copy to .env and fill in values. Anything left blank falls back to the
# defaults in docker-compose.yml or backend/app/config.py.
#
# This is the single source of truth for environment variables. The backend
# container reads these via docker-compose's `environment:` block — there is
# no separate backend/.env. If you need to run the backend natively
# (outside Docker), point pydantic-settings at this file or export the
# vars in your shell.

# JWT signing secret. Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# Google Maps Static / Tiles API key (used for satellite tile fetch).
GOOGLE_MAPS_API_KEY=

# Resend transactional email. If unset, emails are logged to stdout instead
# of being sent — keeps local dev working without an account.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Public base URL of the frontend, used to build links inside outbound emails
# (signup, password reset). For local dev with `docker compose up`, this is
# http://localhost:5173. Set to your real https URL in production.
APP_BASE_URL=http://localhost:5173
